{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/aivis-speech-mobile/schemas/aisp.schema.json",
  "title": "AISP Project",
  "type": "object",
  "required": ["appVersion", "talk", "song"],
  "additionalProperties": false,
  "properties": {
    "appVersion": {
      "type": "string"
    },
    "talk": {
      "type": "object",
      "required": ["audioKeys", "audioItems"],
      "additionalProperties": false,
      "properties": {
        "audioKeys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audioItems": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/audioItem"
          }
        }
      }
    },
    "song": {
      "type": "object",
      "required": ["tpqn", "tempos", "timeSignatures", "tracks", "trackOrder"],
      "additionalProperties": false,
      "properties": {
        "tpqn": { "type": "integer" },
        "tempos": {
          "type": "array",
          "items": { "$ref": "#/$defs/tempo" }
        },
        "timeSignatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeSignature" }
        },
        "tracks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/track" }
        },
        "trackOrder": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "voice": {
      "type": "object",
      "required": ["engineId", "speakerId", "styleId"],
      "additionalProperties": false,
      "properties": {
        "engineId": { "type": "string" },
        "speakerId": { "type": "string" },
        "styleId": { "type": "integer" }
      }
    },
    "mora": {
      "type": "object",
      "required": ["text", "vowel", "vowelLength", "pitch"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "vowel": { "type": "string" },
        "vowelLength": { "type": "number" },
        "pitch": { "type": "number" },
        "consonant": { "type": "string" },
        "consonantLength": { "type": "number" }
      }
    },
    "accentPhrase": {
      "type": "object",
      "required": ["moras", "accent"],
      "additionalProperties": false,
      "properties": {
        "moras": {
          "type": "array",
          "items": { "$ref": "#/$defs/mora" }
        },
        "accent": { "type": "integer" },
        "pauseMora": { "$ref": "#/$defs/mora" },
        "isInterrogative": { "type": "boolean" }
      }
    },
    "audioQuery": {
      "type": "object",
      "required": [
        "accentPhrases",
        "speedScale",
        "intonationScale",
        "pitchScale",
        "volumeScale",
        "pauseLengthScale",
        "prePhonemeLength",
        "postPhonemeLength",
        "outputSamplingRate",
        "outputStereo"
      ],
      "additionalProperties": false,
      "properties": {
        "accentPhrases": {
          "type": "array",
          "items": { "$ref": "#/$defs/accentPhrase" }
        },
        "speedScale": { "type": "number" },
        "intonationScale": { "type": "number" },
        "tempoDynamicsScale": { "type": "number" },
        "pitchScale": { "type": "number" },
        "volumeScale": { "type": "number" },
        "pauseLengthScale": { "type": "number" },
        "prePhonemeLength": { "type": "number" },
        "postPhonemeLength": { "type": "number" },
        "outputSamplingRate": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "const": "engineDefault" }
          ]
        },
        "outputStereo": { "type": "boolean" },
        "kana": { "type": "string" }
      }
    },
    "morphingInfo": {
      "type": "object",
      "required": ["rate", "targetEngineId", "targetSpeakerId", "targetStyleId"],
      "additionalProperties": false,
      "properties": {
        "rate": { "type": "number" },
        "targetEngineId": { "type": "string" },
        "targetSpeakerId": { "type": "string" },
        "targetStyleId": { "type": "integer" }
      }
    },
    "audioItem": {
      "type": "object",
      "required": ["text", "voice"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "voice": { "$ref": "#/$defs/voice" },
        "query": { "$ref": "#/$defs/audioQuery" },
        "presetKey": { "type": "string" },
        "morphingInfo": { "$ref": "#/$defs/morphingInfo" }
      }
    },
    "tempo": {
      "type": "object",
      "required": ["position", "bpm"],
      "additionalProperties": false,
      "properties": {
        "position": { "type": "integer" },
        "bpm": { "type": "number" }
      }
    },
    "timeSignature": {
      "type": "object",
      "required": ["measureNumber", "beats", "beatType"],
      "additionalProperties": false,
      "properties": {
        "measureNumber": { "type": "integer" },
        "beats": { "type": "integer" },
        "beatType": { "type": "integer" }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "name",
        "keyRangeAdjustment",
        "volumeRangeAdjustment",
        "notes",
        "pitchEditData",
        "solo",
        "mute",
        "gain",
        "pan"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "singer": {
          "type": "object",
          "required": ["engineId", "styleId"],
          "additionalProperties": false,
          "properties": {
            "engineId": { "type": "string" },
            "styleId": { "type": "integer" }
          }
        },
        "keyRangeAdjustment": { "type": "number" },
        "volumeRangeAdjustment": { "type": "number" },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "position", "duration", "noteNumber", "lyric"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "position": { "type": "number" },
              "duration": { "type": "number" },
              "noteNumber": { "type": "number" },
              "lyric": { "type": "string" }
            }
          }
        },
        "pitchEditData": {
          "type": "array",
          "items": { "type": "number" }
        },
        "solo": { "type": "boolean" },
        "mute": { "type": "boolean" },
        "gain": { "type": "number" },
        "pan": { "type": "number" }
      }
    }
  }
}
